# ============================================================================
# BIBLIOTECA DE EBOOKS — .env de PRODUCAO (modelo). Copie para .env.production
# e preencha. NUNCA versione o .env.production real (o .gitignore ja o ignora).
#
# ⚠ Variavel de ambiente e lida na CRIACAO do container. Mudou algo aqui?
#     docker-compose -f docker-compose.prod.yml up -d --force-recreate ebooks
# ============================================================================

# --- Banco (PostgreSQL COMPARTILHADO da VPS) --------------------------------
# Host = "postgres" (alias de rede dos apps). Mesmo usuario/senha dos outros
# apps. Se a senha tiver "@", troque por %40. Banco proprio: ebooks.
DATABASE_URL=postgresql://USUARIO:SENHA@postgres:5432/ebooks

# --- Endereco publico ---------------------------------------------------------
# Usado no link do QR code dos eventos. Sem barra no final.
BASE_URL=https://biblioteca.canellaesantos.com.br

# --- Seguranca ---------------------------------------------------------------
# Assina os cookies de sessao. Gere uma vez e NAO troque (trocar desloga todos
# os leitores, que teriam de entrar de novo pelo e-mail):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Senha do painel /admin (equipe). Use uma senha forte.
ADMIN_SENHA=

TZ=America/Sao_Paulo
