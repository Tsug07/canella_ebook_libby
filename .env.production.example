# ============================================================================
# BIBLIOTECA DE EBOOKS — .env de PRODUCAO (modelo). Copie para .env.production
# e preencha. NUNCA versione o .env.production real (o .gitignore ja o ignora).
#
# ⚠ Variavel de ambiente e lida na CRIACAO do container. Mudou algo aqui?
#     docker-compose -f docker-compose.prod.yml up -d --force-recreate ebooks
# ============================================================================

# --- Banco (PostgreSQL COMPARTILHADO da VPS) --------------------------------
# Host = "postgres" (alias de rede dos apps). Mesmo usuario/senha dos outros
# apps. Se a senha tiver "@", troque por %40. Banco proprio: ebooks.
DATABASE_URL=postgresql://USUARIO:SENHA@postgres:5432/ebooks

# --- Endereco publico ---------------------------------------------------------
# Usado no link do QR code dos eventos. Sem barra no final.
BASE_URL=https://biblioteca.canellaesantos.com.br

# --- Seguranca ---------------------------------------------------------------
# Assina os cookies de sessao. Gere uma vez e NAO troque (trocar desloga todos
# os leitores, que teriam de entrar de novo pelo e-mail):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# CHAVE DE INSTALACAO do painel: so serve para criar o PRIMEIRO administrador
# (tela /admin no 1o acesso). Depois cada pessoa tem login proprio (e-mail +
# senha) e esta chave deixa de abrir o painel. Use algo longo e aleatorio:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_SENHA=

TZ=America/Sao_Paulo

# --- Avisos de lead novo (opcional) -------------------------------------------
# Webhook do canal do Discord que recebe cada lead (mesmo esquema da Libby).
# Discord > canal > Editar > Integracoes > Webhooks > Novo webhook > Copiar URL.
DISCORD_WEBHOOK_LEADS=
# Quem marcar no aviso, ex.: <@&1299044385899548752> (cargo) ou <@123...> (pessoa).
DISCORD_MENCOES=
# 0 = nao avisa quem entrou SO pelo QR de evento (so o cadastro completo).
AVISAR_EVENTO=1
# Opcional: tambem manda o aviso de lead para este e-mail.
EMAIL_AVISO_LEADS=

# --- E-mail de boas-vindas ao lead (opcional) ---------------------------------
# Gmail com senha de app (a mesma conta que a Libby usa serve). Sem isto o
# e-mail nao sai, mas o resto funciona normalmente.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Quantos dias um ebook novo fica com a fita "Novo" na estante.
NOVO_DIAS=30

# --- Backup diario (servico ebooks_backup do docker-compose) ------------------
# Hora do backup (0-23) e quantos dias de copias manter.
BACKUP_HORA=3
BACKUP_DIAS=14

# --- Botao "Fale conosco" (WhatsApp) -------------------------------------------
# Em branco = numero da Canella (24 99931-4445) com mensagem pronta e
# utm_source=biblioteca-ebooks. Para usar outro link, cole aqui.
WHATSAPP_URL=
# 0 = nao avisa no Discord cada cadastro de ESTUDANTE (evento grande de faculdade).
AVISAR_ESTUDANTE=1
